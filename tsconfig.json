{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "astro.config.ts", "vitest.config.ts"],
  "exclude": ["dist", ".wrangler", "node_modules"]
}
