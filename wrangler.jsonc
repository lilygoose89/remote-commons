{
  // Remote Commons on Cloudflare Workers. Not Pages.
  // account_id and database_id are placeholders. Do not deploy this file.
  // No routes are set, so a deploy cannot attach a hostname or change DNS.
  // TURNSTILE_SECRET_KEY is a Worker secret (`wrangler secret put`), never a var.
  "name": "remote-commons",
  "account_id": "00000000000000000000000000000000",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "TURNSTILE_REQUIRED": "false",
    "INDEXABLE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-commons",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "remote-commons-preview",
      "vars": {
        "TURNSTILE_REQUIRED": "false",
        "INDEXABLE": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remote-commons-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
